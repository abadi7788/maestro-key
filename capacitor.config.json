{
  "appId": "com.maestrokey.app",
  "appName": "Maestro Key",
  "webDir": "public",
  "server": {
    "url": "https://maestro-key.vercel.app",
    "cleartext": true,
    "allowNavigation": [
      "maestro-key.vercel.app",
      "*.vercel.app"
    ]
  },
  "android": {
    "allowMixedContent": true,
    "captureInput": true,
    "webContentsDebuggingEnabled": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 0,
      "launchAutoHide": true,
      "backgroundColor": "#000000"
    }
  }
}
