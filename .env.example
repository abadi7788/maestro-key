# Database
DATABASE_URL="postgresql://user:password@localhost:5432/maestro_key"

# Security & Encryption (minimum 32 characters in production)
SESSION_SECRET="replace-with-at-least-32-random-characters"
ACCOUNT_ENCRYPTION_KEY="replace-with-at-least-32-random-characters"
ADMIN_INITIAL_PASSWORD="replace-with-strong-initial-password"

# Email / OTP (Resend or SMTP)
RESEND_API_KEY=""
RESEND_FROM="Maestro Key <onboarding@resend.dev>"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# Web Push Notifications (VAPID)
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@example.com"

# WhatsApp Cloud API (optional)
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_ID=""

# AI Receipt Reader (optional)
AI_RECEIPT_URL=""
AI_RECEIPT_KEY=""

# Cron Security
CRON_SECRET="replace-with-at-least-32-random-characters"
STORE_INITIALIZATION="create"
