# Primary Database (Supabase PostgreSQL - Daily Operations)
DATABASE_URL=postgres://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require

# Cold Standby Failover Database (Neon PostgreSQL - Idle unless Supabase fails)
DATABASE_BACKUP_URL=postgres://[user]:[password]@[endpoint].neon.tech/[dbname]?sslmode=require

# Supabase Storage (Temporary Receipt Storage before Telegram Archiving)
SUPABASE_URL=https://[project-ref].supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_RECEIPTS_BUCKET=receipts

# Telegram Bot Archiving (Confirmed Receipts + Daily Lightweight Backups)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ARCHIVE_CHAT_ID=
# Optional: Receive login OTP codes via Telegram if email SMTP/Resend fails
TELEGRAM_ADMIN_CHAT_ID=

# Encryption & Auth
ACCOUNT_ENCRYPTION_KEY=
SESSION_SECRET=
CRON_SECRET=
ADMIN_INITIAL_PASSWORD=

# Resend / Email OTP
RESEND_API_KEY=
RESEND_FROM=Maestro Key <onboarding@resend.dev>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_SECURE=false

# Web Push Notifications
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# WhatsApp Cloud API (Optional)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# AI Receipt (Optional)
AI_RECEIPT_KEY=
AI_RECEIPT_URL=
